---
import { Image } from "astro:assets";
import authorImage from "~/assets/me.jpeg";
import ExternalLinkSVG from "~/icons/external-link.svg";
import GitHubSVG from "~/icons/github.svg";
import XSVG from "~/icons/x.svg";
import MastodonSVG from "~/icons/mastodon.svg";
---

<div class="sm:sticky sm:top-10 sm:h-fit sm:max-w-fit">
  <Image
    class="block aspect-square size-20 overflow-hidden rounded-full"
    height={80}
    width={80}
    src={authorImage}
    layout="fixed"
    loading="eager"
    alt="Author profile picture"
  />
  <h1 class="mt-4 mb-2 text-2xl font-bold text-zinc-900 dark:text-white">
    Kevin
  </h1>
  <p>
    <a
      href="https://twitter.com/astrodotbuild"
      class="text-indigo-500 underline underline-offset-4 dark:text-indigo-300"
      >@astrodotbuild</a
    > maintainer
  </p>
  <ul class="mt-4 grid grid-cols-1 gap-2 sm:mt-6 sm:gap-1">
    <li>
      <a
        class="group inline-flex items-center gap-2 hover:text-zinc-900 dark:hover:text-zinc-100"
        href="https://github.com/kevinzunigacuellar"
      >
        <GitHubSVG
          class="size-4 fill-current"
        />kevinzunigacuellar<ExternalLinkSVG
          class="-ml-1 size-4 stroke-current opacity-0 duration-200 group-hover:-translate-y-0.5 group-hover:opacity-100"
        />
      </a>
    </li>
    <li>
      <a
        class="group inline-flex items-center gap-2 hover:text-zinc-900 dark:hover:text-zinc-100"
        href="https://x.com/kevinzunigacuel"
      >
        <XSVG class="size-4 fill-current" />kevinzunigacuel<ExternalLinkSVG
          class="-ml-1 size-4 stroke-current opacity-0 duration-200 group-hover:-translate-y-0.5 group-hover:opacity-100"
        />
      </a>
    </li>
    <li>
      <a class="group inline-flex items-center gap-2 hover:text-zinc-900 dark:hover:text-zinc-100"
       rel="me" href="https://m.webtoo.ls/@kevinzunigacuellar">
      <MastodonSVG class="size-4 fill-current" />kevinzunigacuellar<ExternalLinkSVG
          class="-ml-1 size-4 stroke-current opacity-0 duration-200 group-hover:-translate-y-0.5 group-hover:opacity-100"
        /></a>
    </li>
  </ul>
</div>
